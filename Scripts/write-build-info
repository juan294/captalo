#!/bin/sh
# Xcode Run Script phase: writes build-info.json into the app's Resources
# before Xcode signs the bundle. `make` passes CAPTALO_COMMIT and
# CAPTALO_DIRTY as build settings, so the script needs no Git access and runs
# sandboxed. A plain xcodebuild call records "unknown". CAPTALO_PRERELEASE
# ("beta.N" or empty) is a project build setting that Scripts/set-version writes.
set -eu
out="${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/build-info.json"
commit="${CAPTALO_COMMIT:-unknown}"
dirty="${CAPTALO_DIRTY:-null}"
built=$(date -u +%Y-%m-%dT%H:%M:%SZ)
prerelease="${CAPTALO_PRERELEASE:-}"
case "$prerelease" in
  ""|beta.[1-9]|beta.[1-9][0-9]|beta.[1-9][0-9][0-9]) ;;
  *) echo "error: CAPTALO_PRERELEASE '$prerelease' is not beta.N; run Scripts/set-version" >&2; exit 1 ;;
esac
mkdir -p "$(dirname "$out")"
printf '{\n  "commit": "%s",\n  "dirty": %s,\n  "configuration": "%s",\n  "built_at": "%s",\n  "prerelease": "%s"\n}\n' \
  "$commit" "$dirty" "$CONFIGURATION" "$built" "$prerelease" > "$out"
