#!/bin/bash
# Fresh-state check, step 4: restores the latest backup (or deletes the
# domain if it was absent), then compares the restored values with the
# backup. Idempotent: run it again to finish an interrupted check. The
# backup is kept; remove it yourself once the comparison has passed.
set -eu
. "$(dirname "$0")/defaults-common.sh"
STATE=$(ls -t "$DIR"/defaults-*.state 2>/dev/null | head -1)
[ -n "$STATE" ] || { echo "defaults-restore: no backup record in $DIR" >&2; exit 1; }
require_quit
if [ "$(cat "$STATE")" = "absent" ]; then
  # Already absent needs no delete. An unreadable domain, a failed delete, or
  # values left behind is never marked restored.
  CURRENT=$(domain_state)
  require_readable "$CURRENT"
  if [ "$CURRENT" = present ]; then
    if ! defaults delete "$DOMAIN" >/dev/null; then
      echo "defaults-restore: deleting $DOMAIN failed; backup not marked restored" >&2
      exit 1
    fi
    CURRENT=$(domain_state)
    require_readable "$CURRENT"
    if [ "$CURRENT" != absent ]; then
      echo "defaults-restore: $DOMAIN still has values after the delete; backup not marked restored" >&2
      exit 1
    fi
  fi
  touch "${STATE%.state}.restored"
  echo "defaults-restore: domain was absent before; verified it is absent again"
  exit 0
fi
BACKUP="${STATE%.state}.plist"
# defaults import merges, so values written during the check are removed first.
defaults delete "$DOMAIN" >/dev/null 2>&1 || true
defaults import "$DOMAIN" "$BACKUP"
if domain_matches "$BACKUP"; then
  touch "${STATE%.state}.restored"
  echo "defaults-restore: restored and verified against $BACKUP"
else
  echo "defaults-restore: restored values differ from $BACKUP" >&2
  exit 1
fi
