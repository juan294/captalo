#!/usr/bin/env python3
"""Release-probe completeness check (plan phase 3, unit 3D, make completeness-test).

Structural gate: exactly one summary per manifest voice (no missing,
duplicated or extra voice), every unit completed exactly once in order, no
unit over 35 s, queued seconds never over 105. The long, stop and
device-change runs must each emit their required record; a missing record is
a failure. Stop latencies must be non-negative numbers and the stopped run's
summary must say "stopped"; unit records for a voice a run did not read, and
missing or mistyped fields, are named failures. Unit-record IDs must cover
the probe's inventory 0..expectedUnits-1 once each, in order, with split
pieces adjacent under one ID (a stopped run: an in-order prefix). Measurements
on the ~20,000-character unpunctuated fixture: first audio, peak footprint,
stop latency mid-reading and the replay span after a simulated device change.

The speech-recognition round trip needs a test-only recognizer download that
was not approved, so it is recorded as "not run"; the owner's listening audit
is the completeness gate (plan, recognition calibration).
"""
import datetime
import json
import os
import shutil
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MAX_UNIT, MAX_QUEUED = 35.0, 105.0


def probe_path():
    # model-tool sets the Xcode developer directory default.
    return subprocess.run([str(ROOT / "Scripts/model-tool")], capture_output=True, text=True, check=True).stdout.strip()


def manifest_version(probe, bundle):
    """The manifest version as the probe computes it (`verify` prints it), so the evidence cannot drift."""
    out = subprocess.run([probe, "verify", "--models", bundle, "--manifest", str(ROOT / "Models.manifest.json")],
                         capture_output=True, text=True).stdout
    return out.rsplit("version ", 1)[-1].strip() if "version " in out else None


def main():
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run = ROOT / ".local" / "completeness" / f"run-{stamp}"
    home = run / "HOME"
    home.mkdir(parents=True)
    probe = probe_path()
    bundle = sys.argv[1] if len(sys.argv) > 1 else str(ROOT / ".local/build/DerivedData/Build/Products/Release/Captalo.app/Contents/Resources/Models")
    manifest = json.loads((ROOT / "Models.manifest.json").read_text())
    failures, evidence = [], {"run": stamp, "bundle": bundle, "manifest": manifest_version(probe, bundle),
                              "recognition": "not run: test recognizer download not approved"}

    def synth(label, fixture, *extra):
        out = run / f"{label}.jsonl"
        result = subprocess.run([probe, "synthesize", "--bundle", bundle, "--store", str(run / "store"),
                                 "--manifest", str(ROOT / "Models.manifest.json"), "--fixture", str(ROOT / "Fixtures" / fixture),
                                 "--out", str(out), *extra], env={"HOME": str(home), "PATH": "/usr/bin:/bin"},
                                capture_output=True, text=True)
        (run / f"{label}.log").write_text(result.stdout + result.stderr)
        if result.returncode != 0:
            failures.append(f"{label}: probe exit {result.returncode}")
            return []
        return [json.loads(line) for line in out.read_text().splitlines()]

    def grouped(records):
        """A run's records by (kind, voice), built once per run."""
        groups = {}
        for r in records:
            groups.setdefault((r.get("kind"), r.get("voice")), []).append(r)
        return groups

    def one(groups, label, kind, voice):
        """The run's single `kind` record for `voice`, or a failure: a missing record never passes."""
        found = [r for (k, _), rs in groups.items() if k == kind for r in rs]
        if len(found) != 1 or found[0].get("voice") != voice:
            failures.append(f"{label}: expected one {kind} record for {voice}, found "
                            f"{[r.get('voice') for r in found] or 'none'}")
            return None
        return found[0]

    @contextmanager
    def field_guard(label):
        """A missing or mistyped field is a named failure, never a traceback."""
        try:
            yield
        except (KeyError, TypeError) as error:
            failures.append(f"{label}: missing or malformed field {error}")

    def only_voices(groups, label, voices):
        """Unit records for a voice the run did not ask for fail; they are never ignored."""
        failures.extend(f"{label}: unit records for {v}, which this run did not read"
                        for v in sorted({str(v) for k, v in groups if k == "unit"} - set(voices)))

    def unit_ids_match(units, expected, splits=None):
        """Unit-record IDs against the probe's inventory 0..expected-1, in record order.

        A runtime split records each piece under its unit's ID, next to each
        other, and adds one record per split. With `splits`, every ID appears,
        once, in order, and the record count is expected + splits; without it
        (a stopped reading), the IDs are an in-order prefix of the inventory.
        """
        ids = [r["unit"] for r in units]
        if not all(isinstance(i, int) and not isinstance(i, bool) and 0 <= i < expected for i in ids):
            return False
        collapsed = [i for n, i in enumerate(ids) if n == 0 or i != ids[n - 1]]
        if splits is None:
            return collapsed == list(range(len(collapsed)))
        return collapsed == list(range(expected)) and len(ids) == expected + splits

    def reading_checks(summary, groups, voice, reassembles=True):
        """A finished reading: every expected unit played once, in order, each unit record complete."""
        units = groups.get(("unit", voice), [])
        checks = {
            "unit records cover IDs 0..expectedUnits-1 once each, in order (split pieces adjacent)":
                unit_ids_match(units, summary["expectedUnits"], summary["oversizeSplits"]),
            "finished": summary["outcome"] == "finished",
            "played every expected unit": summary["expectedUnits"] > 0 and summary["units"] == summary["expectedUnits"],
            "every expected unit played exactly once, in order": summary["playedExactlyOnceInOrder"] is True,
            "every unit record completed, with phonemes and normalized text":
                bool(units) and all(r["completed"] is True and r["phonemes"] > 0 and bool(r["normalizedText"]) for r in units),
            "no unit over 35 s": summary["maxUnitSeconds"] <= MAX_UNIT,
        }
        if reassembles:
            checks["synthesized pieces reassemble the prepared text"] = summary["textReassembles"] is True
        return checks

    def is_duration(value):
        return isinstance(value, (int, float)) and not isinstance(value, bool) and value >= 0

    keys = ("units", "maxUnitSeconds", "maxQueuedSeconds", "firstAudioMs", "totalMs", "peakFootprintMB", "oversizeSplits")
    records = grouped(synth("completeness", "speech-completeness.txt", "--voices", ",".join(manifest["voices"])))
    only_voices(records, "completeness", manifest["voices"])
    summaries = {v: rs for (k, v), rs in records.items() if k == "summary"}
    # The exact manifest inventory: no missing, duplicated or extra voice.
    failures += [f"{v}: no summary" for v in manifest["voices"] if v not in summaries]
    failures += [f"{v}: {len(found)} summaries" for v, found in summaries.items() if len(found) > 1]
    failures += [f"{v}: not in the manifest" for v in summaries if v not in manifest["voices"]]
    for voice in [v for v in manifest["voices"] if len(summaries.get(v, [])) == 1]:
        summary = summaries[voice][0]
        with field_guard(voice):
            checks = reading_checks(summary, records, voice)
            failures.extend(f"{voice}: {name}" for name, ok in checks.items() if not ok)
            evidence.setdefault("voices", {})[voice] = {**{k: summary[k] for k in keys}, "checks": checks}

    voice = manifest["voices"][0]
    long_full = grouped(synth("long", "speech-long-unpunctuated.txt", "--voices", voice))
    long_stop = grouped(synth("long-stop", "speech-long-unpunctuated.txt", "--voices", voice, "--pace", "20",
                              "--stop-after-units", "5"))
    long_device = grouped(synth("long-device", "speech-long-unpunctuated.txt", "--voices", voice, "--pace", "20",
                                "--device-change-after-units", "3"))
    for label, groups in (("long", long_full), ("long-stop", long_stop), ("long-device", long_device)):
        only_voices(groups, label, [voice])

    if s := one(long_full, "long", "summary", voice):
        with field_guard("long"):
            evidence["long"] = {k: s[k] for k in keys}
            failures.extend(f"long fixture: {name}" for name, ok in reading_checks(s, long_full, voice).items() if not ok)
    stop, stop_summary = one(long_stop, "long-stop", "stop", voice), one(long_stop, "long-stop", "summary", voice)
    if stop:
        with field_guard("long-stop"):
            evidence["stop"] = {k: stop[k] for k in ("stopToSilenceMs", "stopToIdleMs")}
            failures.extend(f"stop: {k} {stop[k]!r} is not a non-negative number"
                            for k in ("stopToSilenceMs", "stopToIdleMs") if not is_duration(stop[k]))
    if stop_summary:
        with field_guard("long-stop"):
            if stop_summary["outcome"] != "stopped":
                failures.append(f"stop: outcome {stop_summary['outcome']!r}, expected 'stopped'")
            if not unit_ids_match(long_stop.get(("unit", voice), []), stop_summary["expectedUnits"]):
                failures.append("stop: unit records are not an in-order prefix of the expected units")
    if device := one(long_device, "long-device", "deviceChange", voice):
        with field_guard("long-device"):
            evidence["deviceChange"] = {"replayedUnits": device["replayedUnits"], "replaySpanSeconds": device["replaySpanSeconds"]}
            if len(device["replayedUnits"]) != 1:
                failures.append("device change: expected exactly one replayed (audible) unit")
    if d := one(long_device, "long-device", "summary", voice):
        with field_guard("long-device"):
            evidence["pacedQueue"] = {"maxQueuedSeconds": d["maxQueuedSeconds"], "maxRetained": d["maxRetained"]}
            # As before, text reassembly is checked on the unpaced runs only.
            failures.extend(f"device change: {name}" for name, ok in
                            reading_checks(d, long_device, voice, reassembles=False).items() if not ok)
            # The paced run fills the queue, so the bound is exercised, not vacuous.
            if not 0 < d["maxQueuedSeconds"] <= MAX_QUEUED:
                failures.append(f"paced queue bound: maxQueuedSeconds {d['maxQueuedSeconds']} not in (0, {MAX_QUEUED}]")

    evidence["failures"] = failures
    target = ROOT / ".local" / "completeness" / f"{stamp}.json"
    target.write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps(evidence, indent=2))
    if failures:
        print(f"completeness-test: {len(failures)} failure(s); run kept in {run}")
        return 1
    shutil.rmtree(run)
    print(f"completeness-test: structural checks passed; evidence {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
